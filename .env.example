# ───────────────────────────────────────────────────────
# GESEM Planner · Variables d'entorn
# Copia aquest fitxer a .env i ompla els valors reals.
# Al servidor: chmod 600 .env (només llegible pel propietari)
# ───────────────────────────────────────────────────────

# Port de l'aplicació
PORT=3001

# BASE_URL — URL pública on s'accedeix a l'app (per a links d'email i OAuth callbacks)
BASE_URL=https://planner.gesem.es

# ── SMTP · Enviament d'emails ──────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=comunicacions@example.com
SMTP_PASS=__POSA_LA_PASSWORD_AQUI__
SMTP_FROM="GESEM Planner <comunicacions@example.com>"

# ── HMAC tokens · per a respostes públiques de formadors ──
# Genera amb: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=__GENERA_UNA_CADENA_DE_64_CARACTERS_HEX_AQUI__

# ── Groq · IA (parser emails, propostes canvis, suggeridor formador) ──
# Crea la clau a https://console.groq.com
GROQ_API_KEY=gsk___POSA_LA_CLAU_AQUI__
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Calendar OAuth (opcional · permet 2-way sync) ──
# Veure GOOGLE_OAUTH_SETUP.md per al procediment complet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://planner.gesem.es/api/google/callback

# ── Backups ──
# Directori i nombre de backups antics a mantenir
BACKUP_DIR=/opt/gesem-planner/backups
BACKUP_KEEP=14
